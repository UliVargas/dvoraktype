{
  "name": "dvorak-type",
  "description": "Dvorak typing tutor for Spanish speakers, built with Qwik City, Express and PostgreSQL.",
  "engines": {
    "node": ">=24.22.1"
  },
  "engines-annotation": "24.22.1 is the first 24.x release with the October 2026 security fixes (CVE-2026-111497 and others).",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/express/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "node server/entry.express",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.3",
    "@builder.io/qwik-city": "1.20.3",
    "@eslint/js": "10.0.1",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "canvas-confetti": "^1.9.4",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-qwik": "1.20.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript-plugin-css-modules": "5.3.0",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "compression": "1.8.2",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "postgres": "^3.4.9",
    "zod": "3.25.48"
  }
}
