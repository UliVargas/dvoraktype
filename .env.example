# Copy to .env for local development: cp .env.example .env

# PostgreSQL connection. Matches the db service in compose.yml.
DATABASE_URL="postgres://admin:password@localhost:5432/dvorak_db"

# Optional. Public origin for Qwik City's CSRF check. Without it, the origin is
# derived from X-Forwarded-Proto / X-Forwarded-Host (what Railway's proxy sends).
# ORIGIN="https://dvoraktype.com"

# Optional. HTTP port of the production server (default 3000).
# PORT=3000
